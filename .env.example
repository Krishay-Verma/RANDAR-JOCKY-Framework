# JOCKY configuration. `python start.py` creates .env for you on first run.
# NEVER commit .env.

# SHA-256 hex digest of the API bearer token (python start.py --new-token).
JOCKY_API_TOKEN_HASH=

# HMAC key (>= 32 chars) used to sign compiled bytecode.
JOCKY_BYTECODE_KEY=

# --- Optional ---------------------------------------------------------------
# Comma-separated browser origins allowed to call the API cross-origin.
# Not needed when the UI is served by the API itself (default).
# JOCKY_CORS_ORIGINS=http://localhost:5173

# Directory the `file_hash` collector may read (default: ./sample_evidence).
# JOCKY_EVIDENCE_DIR=

# SQLite database location (default: ./jocky.db).
# JOCKY_DB_PATH=

# Set to false to disable the /docs page.
# JOCKY_DOCS=true
